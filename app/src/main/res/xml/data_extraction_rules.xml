<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-to-device transfer rules.
  Only the local vehicle list and settings are transferred; nothing else is included.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
