<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- brand line -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:letterSpacing="0.22"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/call_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/callStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/call_incoming"
            android:textColor="@color/call_text"
            android:textSize="17sp"
            tools:text="Incoming call" />

        <TextView
            android:id="@+id/callSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/call_privacy_note"
            android:textColor="@color/call_muted"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.7" />

        <!-- avatar with pulsing rings -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp">

            <View
                android:id="@+id/pulseOne"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/pulse_ring" />

            <View
                android:id="@+id/pulseTwo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/pulse_ring" />

            <FrameLayout
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:background="@drawable/avatar_circle">

                <ImageView
                    android:id="@+id/callAvatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_car_front" />
            </FrameLayout>
        </FrameLayout>

        <!-- number plate chip -->
        <TextView
            android:id="@+id/callPlate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/plate_chip"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:paddingStart="20dp"
            android:paddingTop="9dp"
            android:paddingEnd="20dp"
            android:paddingBottom="9dp"
            android:textColor="@color/plate_chip_text"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="UP16AB1234" />

        <TextView
            android:id="@+id/callTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="@string/call_timer_zero"
            android:textColor="@color/call_accent"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ACTIVE / OUTGOING CONTROLS -->
        <LinearLayout
            android:id="@+id/activeActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageButton
                        android:id="@+id/muteButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/circle_glass"
                        android:contentDescription="@string/action_mute"
                        android:scaleType="center"
                        android:src="@drawable/ic_mic_on" />

                    <TextView
                        android:id="@+id/muteLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/action_mute"
                        android:textColor="@color/call_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageButton
                        android:id="@+id/speakerButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/circle_glass"
                        android:contentDescription="@string/action_speaker_on"
                        android:scaleType="center"
                        android:src="@drawable/ic_speaker_on" />

                    <TextView
                        android:id="@+id/speakerLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/action_speaker_on"
                        android:textColor="@color/call_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/hangupButton"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/circle_decline"
                android:contentDescription="@string/action_hang_up"
                android:elevation="6dp"
                android:scaleType="center"
                android:src="@drawable/ic_call_decline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/action_hang_up"
                android:textColor="@color/call_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- INCOMING CONTROLS -->
        <LinearLayout
            android:id="@+id/incomingActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/declineButton"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/circle_decline"
                    android:contentDescription="@string/action_decline"
                    android:elevation="6dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_call_decline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/action_decline"
                    android:textColor="@color/call_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/acceptButton"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/circle_accept"
                    android:contentDescription="@string/action_accept"
                    android:elevation="6dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_call_accept" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/action_accept"
                    android:textColor="@color/call_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
